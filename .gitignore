# ==============================================================================
# SMS-Transfer Monorepo .gitignore
# Covers Node.js Backend, React Frontend (Vite), and Flutter Android Mobile App
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables, Secrets & API Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
firebase-service-account.json
firebase-service-account*.json
service-account*.json
google-services.json

# ------------------------------------------------------------------------------
# 2. Node.js & Web (Backend & Frontend)
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
.cache/
.vite/
.eslintcache
*.tsbuildinfo

# Logs & Debuggers
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Flutter & Dart (Mobile App)
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
doc/api/
coverage/

# Android Studio / Gradle Build Artifacts
**/android/.gradle/
**/android/local.properties
**/android/captures/
**/android/gradleBuild/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/*.apk
**/*.aab
**/*.ap_
*.symbols
*.map.json

# Android Keystores & Signing Keys
*.jks
*.keystore
key.properties

# ------------------------------------------------------------------------------
# 4. Operating System & Editor Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# JetBrains / IntelliJ / Android Studio
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Temporary files
*.swp
*.swo
*~
tmp/
temp/
